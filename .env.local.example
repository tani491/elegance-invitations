# Local development mirrors .env.example. Never paste real production secrets into this file.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[DATABASE-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

AUTH_SECRET="replace-with-local-random-secret"
NEXTAUTH_SECRET="replace-with-local-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="your-r2-bucket-name"
NEXT_PUBLIC_R2_PUBLIC_URL="https://your-public-r2-domain.r2.dev"
CLOUDFLARE_R2_PUBLIC_URL="https://your-public-r2-domain.r2.dev"
