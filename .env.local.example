# Local development mirrors .env.example. Never paste real production secrets into this file.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[DATABASE-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

AUTH_SECRET="replace-with-local-random-secret"
NEXTAUTH_SECRET="replace-with-local-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

SEED_SECRET="replace-with-local-seed-secret"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-temporary-admin-password"

STRIPE_PAYMENT_LINK="https://buy.stripe.com/placeholder"
