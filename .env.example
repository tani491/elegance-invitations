# Prisma application runtime on Supabase transaction pooler / Supavisor.
# Use the exact Transaction pooler string copied from Supabase Connect.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma CLI migrations/db push on direct or session connection.
# Prefer db.[PROJECT-REF].supabase.co:5432 when IPv6 is available, or the Supavisor Session pooler on :5432.
DIRECT_URL="postgresql://postgres:[DATABASE-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="https://your-production-domain.example"
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

SEED_SECRET="replace-with-admin-seed-secret"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-temporary-admin-password"

STRIPE_PAYMENT_LINK="https://buy.stripe.com/placeholder"
